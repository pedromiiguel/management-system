# Lido por src/config/env.ts (validado na subida; fora de produção este arquivo
# é carregado automaticamente — variáveis já definidas no ambiente têm prioridade).

# Conexão com o Postgres (docker compose sobe em localhost:5432)
DATABASE_URL="postgresql://beverage:beverage@localhost:5432/beverage?schema=public"
# Segredo do JWT — obrigatório com NODE_ENV=production; em dev, vazio usa um segredo de desenvolvimento.
JWT_SECRET=
# Expiração do token (padrão 12h)
JWT_EXPIRES_IN="12h"
PORT=3000
# Origens autorizadas a chamar a API, separadas por vírgula (ex.: URL da Vercel).
# Vazio = reflete qualquer origem (use isso só em dev).
CORS_ORIGIN=
# Observabilidade (@nestjs/observe) — credenciais do serviço em observe.nestjs.com.
# Sem as duas, a telemetria fica desligada.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
