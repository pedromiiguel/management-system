{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "globalSetup": "<rootDir>/support/global-setup.ts",
  "moduleNameMapper": {
    "^@beverage/shared$": "<rootDir>/../../../packages/shared/src",
    "^@nestjs/observe$": "<rootDir>/mocks/nestjs-observe.ts"
  }
}
